<h1 style="font-family: sans-serif; font-size: 20px;">FleetPilot alerts</h1>

<p style="font-family: sans-serif; color: #334155;">
  Hi <%= @user.email_address %>, the following items in your fleet need attention:
</p>

<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="font-family: sans-serif;">
  <% @alerts.each do |alert| %>
    <tr>
      <td style="padding: 10px 0; border-bottom: 1px solid #e2e8f0;">
        <span style="display: inline-block; padding: 2px 8px; border-radius: 9999px; font-size: 12px; color: #fff; background: <%= { 'critical' => '#dc2626', 'warning' => '#d97706', 'info' => '#475569' }[alert.severity] %>;">
          <%= alert.severity.upcase %>
        </span>
        <span style="color: #0f172a;"><%= alert.message %></span>
      </td>
    </tr>
  <% end %>
</table>

<p style="font-family: sans-serif; margin-top: 20px;">
  <a href="<%= alerts_url %>" style="color: #0f172a; font-weight: bold;">Review all alerts in FleetPilot →</a>
</p>
