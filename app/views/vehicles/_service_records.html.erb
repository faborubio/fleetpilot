<div class="mt-6 rounded-lg border border-slate-200 bg-white p-5">
  <div class="mb-4 flex items-center justify-between">
    <h2 class="text-sm font-semibold uppercase text-slate-500">Service history</h2>
    <% if policy(ServiceRecord).create? %>
      <%= link_to "Log service", new_vehicle_service_record_path(vehicle),
            class: "rounded-md bg-slate-900 px-3 py-1.5 text-sm font-medium text-white hover:bg-slate-700" %>
    <% end %>
  </div>

  <% if service_records.any? %>
    <table class="w-full text-left text-sm">
      <thead class="text-xs uppercase text-slate-500">
        <tr>
          <th class="py-2">Date</th>
          <th class="py-2">Category</th>
          <th class="py-2">Vendor</th>
          <th class="py-2 text-right">Odometer</th>
          <th class="py-2 text-right">Cost</th>
          <th class="py-2"></th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        <% service_records.each do |record| %>
          <tr>
            <td class="py-2"><%= record.performed_on.to_fs(:long) %></td>
            <td class="py-2 font-medium"><%= record.category.humanize %></td>
            <td class="py-2 text-slate-500"><%= record.vendor || "—" %></td>
            <td class="py-2 text-right tabular-nums"><%= record.odometer ? "#{number_with_delimiter(record.odometer)} mi" : "—" %></td>
            <td class="py-2 text-right tabular-nums"><%= money(record.cost_cents) %></td>
            <td class="py-2 text-right">
              <% if policy(record).destroy? %>
                <%= button_to "Delete", service_record_path(record), method: :delete,
                      data: { turbo_confirm: "Remove this service record?" },
                      class: "text-slate-400 underline hover:text-red-700 cursor-pointer" %>
              <% end %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="text-sm text-slate-500">No service has been logged for this vehicle yet.</p>
  <% end %>
</div>
